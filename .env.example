# CPA (required). Reach the existing CPA service over the shared internal
# network; do not expose its management port publicly.
CPA_BASE_URL=http://cpa:8317
CPA_MANAGEMENT_KEY=
# Timeout for one management API request.
# CPA_TIMEOUT=20s
CPA_API_VERSION=auto
CPA_QUOTA_STRATEGY=auto
ANTIGRAVITY_QUOTA_PROFILE=current
# Sidecar-only context, keyed by canonical opaque Credential.Key; see README.
# Required for old Google OAuth accounts when list metadata omits the project.
# CPA_CONTEXT_OVERRIDES_JSON={"antigravity/0123456789abcdef":{"project_id":"verified-project"}}
# Old fork deployment may use http://cli-proxy-api:8318 on its internal network.
# Verify the actual service name, port and management availability at runtime.

# Quota source (optional). cpa (default) queries CPA's management API directly,
# exactly as before. omc reads the quota Oh My CPA (OMC) has collected through
# its read-only Streamable HTTP MCP endpoint, so CPA is not queried for quota
# directly and OMC stays the only party refreshing upstream quota. The CPA
# credential list is still read for identity and aliases, and Ollama is
# unaffected.
# OMC_MCP_KEY is a read-only bearer key. It is a secret: never logged, never
# rendered, never persisted. Inject it through the Dokploy secrets provider.
QUOTA_SOURCE=cpa
# OMC_MCP_URL=http://omc:8080/omc/api/mcp
# OMC_MCP_KEY=
# Consecutive OMC failures before quota collection falls back to querying CPA
# directly for a cycle. Recovery is automatic: OMC is retried first every cycle.
# OMC_FALLBACK_AFTER=3

# Ollama Cloud (optional). There is no official quota API: the watcher reads
# the settings page with a browser session cookie, which is an unofficial,
# breakable integration. Inject this through the Dokploy secrets provider.
# Account names must be unique.
# OLLAMA_ACCOUNTS_JSON=[{"name":"work","secure_session":""}]
# OLLAMA_TIMEOUT=20s

# Polling and thresholds. Thresholds are used-percentage trigger points and are
# evaluated per quota window: any window crossing fires.
POLL_INTERVAL=15m
# While any account is past its notice threshold, poll this often instead, so
# the last stretch to empty is not missed between two normal polls. 0 = off.
FAST_POLL_INTERVAL=3m
QUOTA_THRESHOLD_NOTICE=80
QUOTA_THRESHOLD_WARN=90
QUOTA_THRESHOLD_URGENT=100
# Per-provider override, merged onto the defaults above. Any omitted field keeps
# its default, e.g. {"ollama":{"notice":80}} only changes notice.
# QUOTA_THRESHOLDS_JSON=
# Comma-separated model groups to ignore in notifications. Defaults to Claude and GPT models.
# Set empty to disable filtering: QUOTA_IGNORED_GROUPS=
# QUOTA_IGNORED_GROUPS=Claude and GPT models

# Rate-limit (429) cooldown watcher. Every COOLDOWN_POLL_INTERVAL it reads only
# CPA's credential list (no quota or upstream calls). It alerts only when CPA's
# retry time lies more than COOLDOWN_ALERT_AFTER ahead: beyond CPA's own 30m
# backoff that means the account/model is used up until the upstream reset.
# CPA's routine short cooldowns are frequent and recover on their own; they are
# never pushed, only counted in the daily digest.
# 0 disables the watcher; otherwise at least 15s. Episodes are tracked in memory,
# so a restart restarts their timers.
COOLDOWN_POLL_INTERVAL=60s
COOLDOWN_ALERT_AFTER=30m

# Quota history: append-only JSONL, one line per credential per window per
# successful ACTIVE collection. Split by day in TZ_NAME. Default dir is
# <dir of STATE_PATH>/history (i.e. /data/history). Retention prunes whole
# expired day files on startup and at each day rollover.
# QUOTA_HISTORY_DIR=/data/history
# QUOTA_HISTORY_RETENTION=2160h

# Digest schedule. Fires every day, weekends and public holidays included.
SUMMARY_TIMES=10:00,17:00
TZ_NAME=Asia/Shanghai

# Wording: casual (team voice, default) or formal (neutral ops wording).
TONE=casual
# NOTIFY_TITLE_QUOTA_EXHAUSTED=额度告急
# NOTIFY_CPA_PAGE_URL=https://cpa.example.com

# Feishu self-built app bot (long connection; no public callback URL needed).
# Exactly one replica may run this.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
# Progress chart on quota cards. It is a client-rendered VChart component, so
# support depends on the viewer's Feishu client version. Set false to fall back
# to a chart-free card without a rebuild; a chart that fails to send is retried
# automatically as a chart-free card regardless.
CARD_CHARTS_ENABLED=true

# Generic webhook, the channel-agnostic event layer.
# WEBHOOK_URL=

# Anomaly attribution for plain timeouts. A single timeout never alerts.
ANOMALY_CONSECUTIVE=3
ANOMALY_WINDOW=5m
ANOMALY_FAILURE_RATE=0.2
ANOMALY_MIN_REQUESTS=5
STALE_AFTER_FAILURES=2

STATE_PATH=/data/state.json
# A rotating copy of the log on the persistent volume (container logs keep only
# a short tail). Default: <dir of STATE_PATH>/logs, 10 files x 10 MB. off = none.
# LOG_DIR=/data/logs
# LOG_FILE_MAX_MB=10
# LOG_FILE_KEEP=10
HTTP_ADDR=:8080
